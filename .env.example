# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=logs
KAFKA_GROUP_ID=log-consumer-group
# For Aiven SASL: SASL_SSL + SCRAM-SHA-256. Keep PLAINTEXT for local Kafka.
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# Paste the Aiven CA PEM as a secret variable, or use a mounted CA file path.
KAFKA_SSL_CA_CERT=
KAFKA_SSL_CAFILE=

# Elasticsearch Configuration
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_INDEX=logs

# Storage backend: 'sqlite', 'elasticsearch' or 's3'
STORAGE_BACKEND=sqlite

# MinIO / S3 Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_secure_password
S3_ENDPOINT_URL=http://localhost:9000
S3_AWS_ACCESS_KEY_ID=minioadmin
S3_AWS_SECRET_ACCESS_KEY=your_secure_password
S3_BUCKET_NAME=log-storage
S3_REGION=us-east-1
S3_PREFIX=logs

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
